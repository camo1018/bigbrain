{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bigbrain-mark-substantive.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bigbrain-maintenance.sh",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
